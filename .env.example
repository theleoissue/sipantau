# Salin berkas ini menjadi .env.local lalu isi dari dashboard Supabase
# (Project Settings -> API). JANGAN commit .env.local ke GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Hanya dibutuhkan Fungsi Tepi dan skrip seed. Rahasia — jangan pernah
# dipakai di komponen klien.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Kunci SERVER untuk Places API (New). Jangan memakai awalan NEXT_PUBLIC.
# Batasi kunci ini hanya ke Places API dan, bila tersedia, alamat IP server.
GOOGLE_MAPS_SERVER_API_KEY=
